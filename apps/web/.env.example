# TrainOS web — local environment
#
# This file is the canonical answer to "what does the app need to run locally".
# Copy to .env and fill in. Commit changes to THIS file whenever a new variable
# is introduced.
#
# Every VITE_* value is PUBLIC BY DESIGN: Vite inlines it into the client
# bundle at build time. Real secrets belong in server-side secret storage, never
# here and never in any VITE_ variable.

# Canonical origin for share links, callbacks and absolute URLs.
#   local:   http://localhost:5180
#   prod:    https://<your-domain>
VITE_SITE_URL=http://localhost:5180

# TrainOS API base, including the /v1 path segment (packages/contract
# API_BASE_PATH). The tenant is implicit from auth and never appears in a path.
VITE_API_BASE_URL=http://localhost:54321/v1

# Which client the data seam mounts: `fixtures` (default) or `supabase`.
# Unset means fixtures, deliberately: a build that forgets this variable serves
# the demo dataset rather than pointing a half-configured app at real data.
VITE_API_MODE=fixtures

# Required only when VITE_API_MODE=supabase. The publishable (anon) key is
# public by design; the service-role key must never appear in a VITE_ variable.
#   local:   http://127.0.0.1:54321
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
