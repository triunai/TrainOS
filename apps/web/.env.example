# TrainOS web — local environment
#
# This file is the canonical answer to "what does the app need to run locally".
# Copy to .env and fill in. Commit changes to THIS file whenever a new variable
# is introduced.
#
# Every VITE_* value is PUBLIC BY DESIGN: Vite inlines it into the client
# bundle at build time. Real secrets belong in server-side secret storage, never
# here and never in any VITE_ variable.

# Canonical origin for share links, callbacks and absolute URLs.
#   local:   http://localhost:5180
#   prod:    https://<your-domain>
# NOT used as the Google sign-in return address: that is always the origin the
# sign-in started on (<origin>/auth/callback), because the PKCE verifier lives
# in that origin's storage. Both origins must be in Supabase's Redirect URLs —
# see docs/deploy/google-auth.md.
VITE_SITE_URL=http://localhost:5180

# TrainOS API base, including the /v1 path segment (packages/contract
# API_BASE_PATH). The tenant is implicit from auth and never appears in a path.
VITE_API_BASE_URL=http://localhost:54321/v1

# Which client the data seam mounts: `fixtures` (default) or `supabase`.
# Unset means fixtures, deliberately: a build that forgets this variable serves
# the demo dataset rather than pointing a half-configured app at real data.
# `supabase` also turns on Google sign-in (/sign-in, /auth/callback) and takes
# identity from core.me(); `fixtures` has no sign-in and no session.
VITE_API_MODE=fixtures

# Required only when VITE_API_MODE=supabase. Real values live in .env.local,
# which is gitignored; these are placeholders.
#   local:   http://127.0.0.1:54321
#   hosted:  https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# The PUBLISHABLE key — the new `sb_publishable_...` type, not a legacy anon
# JWT. Public by design; the secret/service-role key must never appear in a
# VITE_ variable, because Vite inlines every VITE_* value into the bundle.
#
# The new key type must be sent as BOTH `apikey` and `Authorization: Bearer`.
# A raw curl carrying only `apikey` comes back 401
# UNAUTHORIZED_INVALID_API_KEY_TYPE — that is the request being wrong, not the
# key. supabase-js sends both, which is one more reason nothing outside
# shared/api/supabase.ts may build its own client.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<value>
