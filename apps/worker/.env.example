# The worker's database identity. It connects to Postgres directly and assumes
# service_role for the session, because migration 012's worker surface lives in
# the `app` schema and PostgREST exposes only public, core and graphql_public.
# The anon key is a browser credential and is never used here.
WORKER_DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
WORKER_DB_ROLE=service_role

# Identity recorded in app.outbox.claimed_by. Leave unset for host-pid-entropy.
# WORKER_ID=

# Claim shape. The lease may not exceed 360s: app.claim_jobs raises above it.
WORKER_JOB_TYPES=AGENT_RUN_SLICE,SEND_EMAIL,WHATSAPP_SEND,OUTBOX_PUBLISH
WORKER_BATCH_SIZE=5
WORKER_CONCURRENCY=4
WORKER_LEASE_SECONDS=300
WORKER_HEARTBEAT_SECONDS=60
WORKER_IDLE_SLEEP_MS=2000
WORKER_ERROR_SLEEP_MS=5000
WORKER_PACING_MS=0
WORKER_REAP_INTERVAL_MS=60000
WORKER_SHUTDOWN_GRACE_MS=30000

# Per-tenant BYOK keys. Read through this RPC and never from the environment.
# The function does not exist in migrations 001-012; see README.
WORKER_BYOK_RPC=app.provider_key_for_tenant
WORKER_BYOK_TTL_MS=60000

# Transactional email.
RESEND_API_KEY=
WORKER_EMAIL_FROM=

# WhatsApp stays a stub until the allowance ledger and its atomic RPC exist.
WORKER_WHATSAPP_ENABLED=false

PORT=8080
LOG_LEVEL=info
