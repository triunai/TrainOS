# BYOK — put ONE of these in .env.local at the repo root. Any key works.
# Never commit .env.local; the root .gitignore already excludes it.

# Anthropic direct
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (gateway in front of many vendors)
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# DeepSeek
DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anything else that speaks /chat/completions — vLLM, Together, Groq, your own
# gateway. Both variables are required; the endpoint is defined by its URL.
# OPENAI_COMPATIBLE_API_KEY=...
# OPENAI_COMPATIBLE_BASE_URL=https://your-endpoint/v1
