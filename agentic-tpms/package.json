{
  "name": "agentic-tpms",
  "private": true,
  "version": "0.1.0",
  "description": "Single-tenant Training Provider Management System (Agentic CRM) for HRD Corp SBL-Khas operators. Forked design language from TrainOS; independent runtime.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:rollback": "tsx scripts/migrate.ts down",
    "db:reset": "tsx scripts/migrate.ts reset",
    "db:seed": "tsx scripts/seed.ts",
    "worker": "tsx worker/index.ts",
    "golden-path": "tsx scripts/golden-path.ts",
    "audit:verify": "tsx scripts/audit-verify.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "docs:fsm": "tsx scripts/gen-fsm-doc.ts",
    "ocr:dev": "cd services/paddleocr && TPMS_OCR_DEV=1 .venv/bin/uvicorn app.main:app --port 8866",
    "test:ocr": "cd services/paddleocr && .venv/bin/python -m pytest -q"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@univerjs/core": "1.0.2",
    "@univerjs/engine-formula": "1.0.2",
    "@univerjs/preset-sheets-core": "1.0.2",
    "@univerjs/presets": "1.0.2",
    "@univerjs/sheets": "1.0.2",
    "@univerjs/sheets-formula": "1.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "exifr": "^7.1.3",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "next": "^14.2.35",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rxjs": "^7.8.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "playwright-core": "^1.56.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
