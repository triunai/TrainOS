# ---- Database (PostgreSQL 16 + pgvector + pgcrypto) ----------------------
DATABASE_URL=postgres://tpms:tpms@localhost:5432/tpms
# Used by the integration tests and the golden-path run. Never point this at a
# database you care about: the tests reset it.
TEST_DATABASE_URL=postgres://tpms:tpms@localhost:5432/tpms_test

# ---- Secrets (generate with: openssl rand -hex 32) -----------------------
# AES-256 key for NRIC encryption (pgcrypto) and BYOK provider-key encryption.
TPMS_MASTER_KEY=change-me-64-hex-chars
# HMAC pepper for NRIC hashes (dedupe without a brute-forceable plain SHA-256).
TPMS_NRIC_PEPPER=change-me
# Signs zero-auth participant magic links (HS256).
TPMS_JWT_SECRET=change-me

# ---- Public URLs -------------------------------------------------------------
TPMS_PUBLIC_BASE_URL=http://localhost:3100
TPMS_PROVIDER_NAME=Alex Training Sdn Bhd
TPMS_PROVIDER_HRDC_ID=TP-000000
TPMS_OPERATOR_TZ=Asia/Kuala_Lumpur

# ---- Optional protection for the operator cockpit ---------------------------
# user:password. When set, every cockpit route requires HTTP Basic auth.
# Public routes (/c, /q, /verify, /api/v1/public, webhooks) stay open.
TPMS_BASIC_AUTH=

# ---- Storage -----------------------------------------------------------------
TPMS_STORAGE_DIR=./storage

# ---- Level 2 extraction microservice (services/paddleocr) -------------------
PADDLEOCR_URL=http://localhost:8866
# Read by the Python service itself, not the Next app:
#   TPMS_OCR_DEV=1     enables POST /v1/dev/synthesize-t3 (synthetic scans for demos/tests)
#   TPMS_OCR_PADDLE=0  forces the paddle-free path even when paddleocr is installed

# ---- Bring your own key (any subset; the tiers fall back to templates) -----
# L1 fast classifier (Gemini Flash Lite via its OpenAI-compatible endpoint)
GEMINI_API_KEY=
# L3 domain specialists (DeepSeek direct, or via OpenRouter)
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# L4 copywriter (Claude)
ANTHROPIC_API_KEY=
# Embeddings (any OpenAI-compatible /embeddings endpoint, 1536 dims)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
USD_TO_MYR=4.45

# ---- Webhook verification ---------------------------------------------------
META_APP_SECRET=
META_VERIFY_TOKEN=
# Fetches Lead Ads field_data from the Graph API for webhook notifications.
META_PAGE_ACCESS_TOKEN=
# Google Ads lead-form webhook key (google_key in the payload).
GOOGLE_WEBHOOK_KEY=
# Shared secret for the LinkedIn / web-form webhooks (header x-tpms-webhook-secret).
LEAD_WEBHOOK_SECRET=
# Inbound mail routing: the virtual forwarding mailbox and the smart-BCC address.
LEAD_INBOX_ADDRESS=inbox-leads@tp-crm.io
SMART_BCC_ADDRESS=sync@tp-crm.io
# Staff domains (comma-separated) so a BCC'd staff sender is recorded as owner, not lead.
STAFF_EMAIL_DOMAINS=alextraining.my
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INBOUND_MAIL_SECRET=

# ---- Finance ---------------------------------------------------------------
# Tax-inclusive SST as a fraction (e.g. 0.08). Training-service SST treatment
# must be confirmed by the provider's tax adviser; default 0.
TPMS_SST_RATE=0
# Sales commission as a fraction of the approved grant; 0 = no commission PV.
TPMS_COMMISSION_RATE=0

# ---- Outbound mail (dispatch is logged-only until SMTP is configured) ------
SMTP_URL=
MAIL_FROM=
